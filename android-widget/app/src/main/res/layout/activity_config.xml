<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tm_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="위젯에 보일 작업"
        android:textColor="@color/tm_deep"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="오늘이 마감일인 작업 가운데 어떤 것을 보일까요?"
        android:textColor="@color/tm_ink"
        android:textSize="15sp" />

    <Button
        android:id="@+id/mine"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/btn_primary"
        android:stateListAnimator="@null"
        android:text="내 작업 (내가 담당인 것만)"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/all"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_ghost"
        android:stateListAnimator="@null"
        android:text="팀 전체"
        android:textColor="@color/tm_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 로그인 전이면 먼저 앱에서 로그인하게 -->
    <LinearLayout
        android:id="@+id/need_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="아직 로그인하지 않았습니다. 고른 뒤 앱에서 로그인하면 위젯에 작업이 나옵니다."
            android:textColor="@color/tm_red"
            android:textSize="14sp" />

        <Button
            android:id="@+id/open_app"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_ghost"
            android:stateListAnimator="@null"
            android:text="앱 열어 로그인"
            android:textColor="@color/tm_ink"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>

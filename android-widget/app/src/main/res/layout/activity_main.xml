<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tm_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="MATE 오늘"
            android:textColor="@color/tm_deep"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="작업 관리 캘린더에서 오늘이 마감일인 작업을 홈 화면 위젯으로 보여 줍니다."
            android:textColor="@color/tm_ink"
            android:textSize="15sp" />

        <!-- 로그인 전 -->
        <LinearLayout
            android:id="@+id/login_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="작업 관리 계정으로 로그인"
                android:textColor="@color/tm_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/field_bg"
                android:hint="이메일"
                android:inputType="textEmailAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:autofillHints="password"
                android:background="@drawable/field_bg"
                android:hint="비밀번호"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="16sp" />

            <Button
                android:id="@+id/login"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null"
                android:text="로그인"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/login_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/tm_red"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="2dp"
                android:text="웹 작업 관리와 같은 메일 · 비밀번호입니다. 승인된 팀원만 볼 수 있습니다."
                android:textColor="@color/tm_sub"
                android:textSize="13.5sp" />
        </LinearLayout>

        <!-- 로그인 뒤 -->
        <LinearLayout
            android:id="@+id/status_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/who"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tm_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/tm_sub"
                android:textSize="14.5sp" />

            <Button
                android:id="@+id/refresh"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null"
                android:text="위젯 지금 새로고침"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/open_web"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_ghost"
                android:stateListAnimator="@null"
                android:text="웹 작업 관리 열기"
                android:textColor="@color/tm_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="위젯 놓는 법"
                android:textColor="@color/tm_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="1. 홈 화면 빈 곳을 길게 누릅니다.\n2. 위젯을 누르고 'MATE 오늘'을 찾아 놓습니다.\n3. '내 작업' 또는 '팀 전체'를 고릅니다.\n위젯을 길게 누르면 범위를 다시 고를 수 있고, 30분마다 저절로 새로 읽습니다."
                android:textColor="@color/tm_sub"
                android:textSize="14sp" />

            <Button
                android:id="@+id/logout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/btn_ghost"
                android:stateListAnimator="@null"
                android:text="로그아웃"
                android:textColor="@color/tm_sub"
                android:textSize="14.5sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

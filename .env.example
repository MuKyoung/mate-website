# 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 git 에 올라가지 않는다.

# ── 작업 관리 도구(/taskmanager) - 팀이 함께 쓰는 Supabase (TASKMANAGER_SETUP.md)
# 비워 두면 각자 브라우저에만 저장한다. service_role 키는 넣지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 견적 문의 메일 (src/app/api/contact) - Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=

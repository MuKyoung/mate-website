<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MATE 캘린더 - Hub 의 내 작업을 Windows 바탕화면 캘린더 위젯으로 띄운다.
    .NET Framework 4.8 은 Windows 10(1903+) · 11 에 들어 있어 따로 깔 것이 없다 - exe 하나로 돈다.
    빌드 · 배포 순서는 README.md.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>MateCalendar</AssemblyName>
    <RootNamespace>MateCalendar</RootNamespace>
    <StartupObject>MateCalendar.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAppConfig>false</GenerateAppConfig>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>

    <!-- 고칠 때마다 올린다. 위젯이 public/downloads/mate-calendar.json 의 version 과 견줘 업데이트를 알린다 -->
    <Version>1.0.0</Version>
    <Product>MATE 캘린더</Product>
    <AssemblyTitle>MATE 캘린더</AssemblyTitle>
    <Company>MATE</Company>
    <Copyright>© 2026 MATE</Copyright>
    <Description>Hub 의 내 작업을 바탕화면 캘린더 위젯으로 보여 줍니다.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\Pretendard-Regular.otf" />
    <Resource Include="Fonts\Pretendard-Medium.otf" />
    <Resource Include="Fonts\Pretendard-Bold.otf" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
